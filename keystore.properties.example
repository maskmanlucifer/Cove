# Copy to keystore.properties (git-ignored) and fill in. Only needed for a signed release build;
# without it, release builds fall back to the debug key and are not suitable to distribute.
# Create the key with:
#   keytool -genkeypair -v -keystore cove-release.jks -alias cove -keyalg RSA -keysize 4096 -validity 10000
storeFile=cove-release.jks
storePassword=
keyAlias=cove
keyPassword=
